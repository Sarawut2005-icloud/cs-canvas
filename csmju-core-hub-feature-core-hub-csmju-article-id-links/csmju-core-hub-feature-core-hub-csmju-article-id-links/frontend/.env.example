# Base URL of the NestJS Core API (server-side only — never exposed to the browser).
# The frontend talks to the backend from route handlers, server components and proxy.ts,
# so the token stays in an httpOnly cookie and never reaches client JS.
BACKEND_API_URL=http://127.0.0.1:3000/api/v1

# Port the Next.js dev/start server listens on (see package.json scripts).
# 3001 ถูกจองไว้ให้ demo-student-subsystem แล้ว (callback_url ในทะเบียน)
# frontend ของ Core Hub จึงใช้ 3100
PORT=3100

# MJU SSO (sso.mju.ac.th). Leave empty to hide the "เข้าสู่ระบบด้วย MJU SSO" button.
# The same client ID must be set on the Core API (it does the code exchange).
MJU_CLIENT_ID=
# MJU_SSO_SIGNIN_URL=https://sso.mju.ac.th/signin.aspx
# MJU_SSO_SIGNOUT_URL=https://sso.mju.ac.th/signout.aspx
