# Copy to .env next to compose.yml — chmod 600, never commit.

# --- This stack on this host -------------------------------------------------
# Compose project: prefixes containers, images and the database volume. A
# second stack on the same host (e.g. a dev server beside production) needs
# its own directory, its own .env and a different name and ports below.
COMPOSE_PROJECT_NAME=csmju-core-hub
# Absolute path of the repository checkout (branch develop) the images build from.
REPO_DIR=/home/<deploy-user>/projects/csmju-core-hub
# uid of the deploying account (`id -u`). Both app containers run as this uid
# so the 0600 signing keys and the uploads directory stay private on the host.
DEPLOY_UID=<id -u>
# Loopback ports the reverse proxy forwards to: the site, and /api/v1/.
WEB_HOST_PORT=3000
API_HOST_PORT=3010

# --- Database ----------------------------------------------------------------
POSTGRES_USER=core_hub
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=core_hub

# --- Core API ----------------------------------------------------------------
# Public origin the browser and subsystem backends use (no /api/v1). Image
# URLs are built from it.
PUBLIC_URL=https://<domain>
# Private hops in front of the API: the reverse proxy on the host and the web
# container. Leave the default unless the network shape changes.
TRUST_PROXY=loopback, uniquelocal
# Pre-launch only: true lets teams register http://localhost callbacks and
# sign in to subsystems running on their own machines. Set it back to false
# before launch — registration (400) and SSO to those callbacks (409) close
# at once.
ALLOW_LOCALHOST_CALLBACKS=false
# production, always. A different value is only for the documented fallback
# in docs/DEPLOYMENT.md — never to open localhost callbacks (use the flag).
API_NODE_ENV=production
# Versions a subsystem may declare: the tags of csmju2030-standards, cached
# for an hour. Until the first fetch succeeds the fallback list is used.
# STANDARDS_TAGS_TOKEN only if the standards repo becomes private.
STANDARDS_TAGS_URL=https://api.github.com/repos/CSMJU2030/csmju2030-standards/tags?per_page=100
STANDARDS_VERSIONS_FALLBACK=1.7.4,1.7.3,1.7.2,1.0.6
STANDARDS_TAGS_TOKEN=

# Bootstrap admin (admin@core.local) — used only when the database has no
# administrator yet (the very first start). At least 12 characters. Production
# never seeds test accounts; once a real admin exists this can be left empty.
SEED_ADMIN_PASSWORD=<openssl rand -base64 18>

# --- MJU SSO (leave both empty to turn it off; /auth/mju/login then answers 503) ---
MJU_CLIENT_ID=<client id from the university>
MJU_SUBJECT_SECRET=<openssl rand -hex 32 — never change after go-live>
