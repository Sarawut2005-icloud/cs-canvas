# ---------------------------------------------------------------------------
# CSMJU2030 Core Hub (core-api) — ตัวอย่าง environment
# คัดลอกเป็น .env ก่อนรัน npm install   (ห้าม commit .env)
# ---------------------------------------------------------------------------

APP_NAME=core-api
NODE_ENV=development
PORT=3000

# ฐานข้อมูลของ Core Hub เท่านั้น (subsystem ต้องใช้ฐานข้อมูลของตัวเอง)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/core_hub"

# --- รูปภาพ ------------------------------------------------------------------
# โฟลเดอร์เก็บไฟล์รูปที่อัปโหลด (แยกย่อยตามประเภทและเดือน) ถ้าเป็น path สัมพัทธ์
# จะนับจากโฟลเดอร์ที่รัน backend · ใน Docker ต้อง mount เป็น volume ไฟล์จะได้ไม่หาย
UPLOAD_DIR=uploads

# origin สาธารณะของ API นี้ ใช้สร้าง URL รูปแบบเต็ม เช่น https://core.example.ac.th
# ว่างไว้ได้ตอน development — จะใช้ host ของ request แทน (หลัง reverse proxy ต้องตั้งเสมอ)
PUBLIC_URL=

# รูปที่ลบแล้ว (soft delete) จะถูกลบไฟล์และแถวทิ้งถาวรเมื่อครบกี่วัน งานรันทุกคืนตี 3
# IMAGE_PURGE_AFTER_DAYS=30

# --- JWT (RS256) -----------------------------------------------------------
# Core Hub เซ็น access/refresh token ด้วยคู่กุญแจ RSA ไม่ใช่ secret
# jwt-private.pem ถูก gitignore ไว้ — ดูวิธีสร้างใน README ข้อ "การติดตั้ง"
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ค่าที่เหลือจากรุ่นก่อน ปัจจุบันโค้ดไม่ได้ใช้ (โทเคนเซ็นด้วย RS256 key ด้านบน)
JWT_SECRET=change-me-not-used

# --- IP จริงของผู้เรียก --------------------------------------------------------
# ว่าง = ไม่มี proxy ข้างหน้า: rate limit ใช้ IP ที่ต่อเข้ามาตรง ๆ และเมิน
# X-Forwarded-For ที่ผู้เรียกใส่มาเอง
# dev server (cloudflared + core-hub-web อยู่ข้างหน้า): loopback, uniquelocal
TRUST_PROXY=

# --- โหมดก่อนเปิดใช้ (callback http://localhost บน server จริง) -----------------
# NODE_ENV=production รับ callback/base URL แบบ https เท่านั้น · ตั้ง true ให้ server
# จริงรับ http://localhost (127.0.0.1 · [::1]) ด้วย เพื่อให้ทีมรันระบบย่อยบนเครื่อง
# ตัวเองแล้ว login ผ่าน server ได้ — ใช้ช่วงก่อนเปิดใช้เท่านั้น
# ปิด (ค่าอื่นทุกค่าที่ไม่ใช่ true) แล้วทั้งการลงทะเบียน (400) และ SSO ไป callback
# http:// ที่ลงทะเบียนไว้ (409) ปิดทันที · ไม่ใช่ production = ไม่สนใจค่านี้
ALLOW_LOCALHOST_CALLBACKS=false

# --- เวอร์ชันมาตรฐานที่ระบบย่อยเลือกได้ (standardsVersion) ----------------------
# backend อ่าน tag จริงของ csmju2030-standards (เก็บเฉพาะ vX.Y.Z · cache 1 ชั่วโมง)
# ดึงไม่ได้ใช้ cache ล่าสุด · ไม่เคยดึงได้เลยใช้ STANDARDS_VERSIONS_FALLBACK (คั่นด้วย ,)
# ว่าง STANDARDS_TAGS_URL = ไม่ดึงเลย ใช้ fallback อย่างเดียว
STANDARDS_TAGS_URL=https://api.github.com/repos/CSMJU2030/csmju2030-standards/tags?per_page=100
STANDARDS_VERSIONS_FALLBACK=1.7.4,1.7.3,1.7.2,1.0.6
# ถ้าวันหน้า repo standards เป็น private: token ที่อ่าน repo ได้ (ไม่บังคับ)
STANDARDS_TAGS_TOKEN=

# --- Rate limit (ค่า default ตาม SSO_FIX_HANDOFF 5.9 ไม่ต้องตั้งก็ได้) ---------
# ชั้น 1 ต่อ IP ทั้งแอป — หลวมเพราะห้องแล็บทั้งห้องออกเน็ตด้วย IP เดียว
# RATE_LIMIT_IP_BURST_LIMIT=600
# RATE_LIMIT_IP_BURST_WINDOW_SEC=10
# RATE_LIMIT_IP_SUSTAINED_LIMIT=3000
# RATE_LIMIT_IP_SUSTAINED_WINDOW_SEC=60
# ชั้น 2 ต่อผู้ใช้ที่ login แล้ว
# RATE_LIMIT_USER_BURST_LIMIT=100
# RATE_LIMIT_USER_BURST_WINDOW_SEC=10
# RATE_LIMIT_USER_SUSTAINED_LIMIT=600
# RATE_LIMIT_USER_SUSTAINED_WINDOW_SEC=60
# เพดานเฉพาะ route ต่อ IP
# RATE_LIMIT_LOGIN_LIMIT=60
# RATE_LIMIT_LOGIN_WINDOW_SEC=60
# RATE_LIMIT_REFRESH_LIMIT=120
# RATE_LIMIT_REFRESH_WINDOW_SEC=60
# RATE_LIMIT_IMAGE_UPLOAD_LIMIT=60
# RATE_LIMIT_IMAGE_UPLOAD_WINDOW_SEC=60
# RATE_LIMIT_CHANGE_PASSWORD_LIMIT=10
# RATE_LIMIT_CHANGE_PASSWORD_WINDOW_SEC=60
# ใส่รหัสผิดต่ออีเมลกี่ครั้งภายในกี่วินาที แล้วตอบ 429 จนครบเวลา
# (รหัสปัจจุบันที่ผิดตอน change-password นับรวมในตัวนับเดียวกัน)
# LOGIN_LOCKOUT_LIMIT=10
# LOGIN_LOCKOUT_WINDOW_SEC=900
# --- CORS ------------------------------------------------------------------
# ปกติปิด: เบราว์เซอร์ไม่ได้เรียก Core API ตรง ๆ (frontend เรียกฝั่ง server)
# ถ้าจำเป็นให้ระบุ origin ที่อนุญาตแบบเป๊ะ คั่นด้วยจุลภาค
# CORS_ORIGINS=https://csmju2030.jowave.com

# --- Seed (prisma/seed.ts) ---------------------------------------------------
# development ไม่ต้องตั้ง — seed สร้างบัญชีทดสอบ admin|student|staff|alumni@core.local (password1..4 ตาม README)
# production ไม่สร้างบัญชีทดสอบเลย ยกเว้นฐานที่ยังไม่มี admin สักคน (สตาร์ตครั้งแรก) จะได้ admin ตั้งต้น 1 บัญชี
# ซึ่งต้องตั้ง SEED_ADMIN_PASSWORD (>= 12 ตัวอักษร) — ฐานที่มี admin แล้วไม่ต้องตั้ง
# SEED_ADMIN_PASSWORD=
# รอบถัดไป seed จะไม่ทับรหัสผ่านที่มีอยู่ เว้นแต่ตั้ง SEED_RESET_PASSWORDS=true

# --- ค่าที่ตรึงไว้ในโค้ด (ไม่ได้อ่านจาก env) --------------------------------
# issuer  = core-hub
# audience = csmju2030
# kid      = core-hub-2026
# แก้ค่าเหล่านี้จะทำให้ subsystem ทุกตัวใช้งานไม่ได้ — ดู CSMJU2030 Subsystem Standard v1.0

# --- MJU SSO (sso.mju.ac.th) --------------------------------------------------
# เว้นว่าง = ปิดปุ่ม "เข้าสู่ระบบด้วย MJU SSO"
# clientID ที่มหาวิทยาลัยออกให้ (ค่าเดียวกับที่ frontend ใช้สร้างลิงก์ signin.aspx?cid=)
# MJU_CLIENT_ID=
# MJU_SSO_TOKEN_URL=https://sso.mju.ac.th/token.aspx
# secret สำหรับ HMAC ของ citizenID → users.mju_subject (32+ ตัวอักษร, openssl rand -hex 32)
# เปลี่ยนค่านี้แล้วบัญชี SSO เดิมจะจับคู่ไม่เจอ — ห้ามเปลี่ยนหลังใช้งานจริง
# MJU_SUBJECT_SECRET=
