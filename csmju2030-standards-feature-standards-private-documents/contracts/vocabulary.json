{
  "$comment": "คำศัพท์ปิด - subsystem ห้ามคิดค่าใหม่นอกรายการนี้",
  "standardsVersion": "1.1",
  "coreRoles": [
    "student",
    "alumni",
    "staff",
    "lecturer",
    "guest",
    "admin"
  ],
  "permissionFormat": "<resource>:<action>[:own|:any]",
  "permissionExamples": [
    "student:read:own",
    "student:read:any",
    "course:create",
    "course:delete",
    "enrollment:update:own"
  ],
  "requiredEnvVars": [
    "PORT",
    "DATABASE_URL",
    "CORE_HUB_URL",
    "CORE_HUB_JWKS_URL",
    "CORE_HUB_ISSUER",
    "CORE_HUB_AUDIENCE",
    "SUBSYSTEM_ID"
  ],
  "requiredRoutes": {
    "health": "GET /api/health",
    "me": "GET /api/v1/me",
    "ssoLogin": "GET /auth/login",
    "ssoCallback": "GET /auth/callback",
    "ssoLogout": "POST /auth/logout"
  },
  "ssoCookies": {
    "$comment": "<name> = ชื่อระบบในทะเบียน (เท่ากับ SUBSYSTEM_ID) - ตรงกับ sso.sessionCookieSuffix / stateCookieSuffix ใน jwt-contract.json",
    "session": "<name>_access_token",
    "state": "<name>_sso_state"
  },
  "ssoQueryParams": [
    "access_token",
    "token_type",
    "expires_in",
    "state"
  ],
  "subsystemStatus": {
    "approvalStatus": [
      "PENDING",
      "APPROVED",
      "REJECTED"
    ],
    "status": [
      "INACTIVE",
      "ACTIVE",
      "SUSPENDED"
    ],
    "exceptionStatus": [
      "REQUESTED",
      "APPROVED",
      "REJECTED"
    ]
  },
  "coreHubEnums": {
    "$comment": "ค่าที่ Core Hub ส่งใน API (docs/reference-data.md ข้อ 4.8) - Core Hub เพิ่มค่าได้ ระบบย่อยต้องแสดงค่าที่ไม่รู้จักได้โดยไม่พัง",
    "roomType": [
      "LECTURE",
      "LAB",
      "SEMINAR",
      "MEETING",
      "PROJECT",
      "OFFICE"
    ],
    "curriculumCategory": [
      "GENERAL_EDUCATION",
      "CORE",
      "MAJOR_REQUIRED",
      "MAJOR_ELECTIVE",
      "FREE_ELECTIVE",
      "OTHER"
    ],
    "personType": [
      "STUDENT",
      "STAFF"
    ],
    "personStatus": [
      "ACTIVE",
      "INACTIVE",
      "GRADUATED"
    ],
    "personStatusFilter": [
      "ACTIVE",
      "INACTIVE",
      "GRADUATED",
      "ALL"
    ],
    "staffType": [
      "LECTURER",
      "OFFICER",
      "TECHNICIAN",
      "OTHER"
    ],
    "imageCategory": [
      "PROFILE",
      "NEWS",
      "GENERAL"
    ]
  },
  "conventions": {
    "fieldCase": "camelCase",
    "snakeCaseExceptions": [
      "access_token",
      "token_type",
      "expires_in",
      "callback_url",
      "state"
    ],
    "idFormat": "uuid-v4 (id ที่ระบบย่อยสร้างเอง)",
    "coreUserIdFormat": "opaque string ยาวไม่เกิน 64 - ไม่ใช่ UUID เสมอไป (user-<studentCode> หรือ UUID) - เก็บเป็น text ห้าม validate เป็น UUID",
    "referenceCodePattern": "^[A-Z0-9-]{1,50}$",
    "dateFormat": "ISO-8601 UTC (suffix Z)",
    "yearCalendar": "พุทธศักราช (academicYear, entryYear, code ภาค เช่น 2569-1)",
    "paginationQuery": "?page=<1..>&limit=<1..100>",
    "paginationDefaults": {
      "page": 1,
      "limit": 20
    },
    "collectionMeta": [
      "total",
      "page",
      "limit",
      "totalPages"
    ],
    "ownershipRule": "record.coreUserId === token.sub",
    "clockSkewSeconds": 60,
    "jwksCacheTtlMinutes": 10,
    "referenceDataCache": {
      "$comment": "docs/reference-data.md ข้อ 7.3 - cache รวมทุกผู้ใช้ · ใช้ของเก่าตอน Core Hub ล่ม · ข้อมูลบุคคลห้าม cache",
      "ttlMinutes": 10,
      "minRefreshIntervalSeconds": 30,
      "requestTimeoutSeconds": 5,
      "staleOnError": true
    }
  },
  "stack": {
    "mandatory": true,
    "runtime": "node@22.x",
    "language": "typescript@^5.9",
    "framework": "@nestjs/*@^11 (platform-express)",
    "config": "@nestjs/config@^4.0.4",
    "orm": {
      "prisma": "7.9.1",
      "@prisma/client": "7.9.1",
      "@prisma/adapter-pg": "7.9.1",
      "pg": "^8.23"
    },
    "database": "postgresql@16+",
    "validation": {
      "class-validator": "^0.15.1",
      "class-transformer": "^0.5.1"
    },
    "jwt": "jose@^5.10 (ห้ามใช้ passport-jwt ในฝั่ง subsystem)",
    "testing": {
      "jest": "^30",
      "ts-jest": "^29.4",
      "supertest": "^7"
    },
    "frontend": "next@15.5+ (App Router) - ต้องมีคำสั่ง next typegen (tech-stack.md)",
    "packageManager": "pnpm@12.3.4 (ต้อง commit pnpm-lock.yaml · ห้ามมี package-lock.json / yarn.lock - QA-05)"
  },
  "naming": {
    "database": {
      "table": "plural snake_case ผ่าน @@map",
      "column": "snake_case ผ่าน @map",
      "prismaField": "camelCase",
      "primaryKey": "id (uuid v4)",
      "foreignKey": "<entity>_id",
      "coreReferences": {
        "core_user_id": "claim sub - text ≤ 64 · index ไม่ unique",
        "person_code": "personCode จาก GET /api/v1/people/me ตอนเกิดรายการ - text null ได้",
        "<dataset>_code": "code ของข้อมูลอ้างอิง เช่น room_code faculty_code term_code course_code - ไม่เก็บชื่อ ไม่เก็บ id",
        "image_id": "id ของรูปจาก POST /api/v1/images"
      },
      "timestamps": [
        "created_at",
        "updated_at"
      ],
      "boolean": "is_* / has_*",
      "enumName": "PascalCase",
      "enumValue": "UPPER_SNAKE_CASE",
      "databaseName": "<subsystem>_db"
    },
    "api": {
      "prefix": "/api/v1",
      "healthPath": "/api/health (ไม่มี version)",
      "ssoCallbackPath": "/auth/callback (นอก prefix /api)",
      "resource": "plural kebab-case",
      "maxNestingDepth": 1,
      "trailingSlash": false,
      "pathParam": "uuid v4 (id ของระบบเอง) · code ของ Core Hub ตาม referenceCodePattern · อื่น ๆ ตอบ 400",
      "queryParam": "camelCase",
      "createStatus": 201,
      "deleteResponse": "200 + { id, deleted: true }",
      "avoidMethods": [
        "PUT"
      ]
    }
  }
}
