# Backend (NestJS) of this subsystem — next.config.ts passes /api/*, /auth/login,
# /auth/callback and /auth/logout on to it. Use your team's backend port (42xx).
# Read at build time: the Docker image is built with http://api:4000 instead
# (Dockerfile · standards docs/deployment.md 3.2), so leave this file for dev.
BACKEND_URL=http://127.0.0.1:4200

# หน้าเว็บ Core Hub (portal ที่ผู้ใช้ login) — ปุ่ม "กลับ CSMJU Portal" ใน CsmjuAppShell พาไปที่นี่
# ไม่ตั้ง = ไม่แสดงปุ่ม · ต้องเป็นค่าเดียวกับ CORE_HUB_WEB_URL ของ backend
CORE_HUB_WEB_URL=https://csmju2030.jowave.com
